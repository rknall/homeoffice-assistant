{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-bare-python.sh",
            "timeout": 10,
            "statusMessage": "Checking for bare python"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-tree-rewrite.sh",
            "timeout": 10,
            "statusMessage": "Checking for working-tree git rewrites"
          }
        ]
      }
    ]
  }
}
