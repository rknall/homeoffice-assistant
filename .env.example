# HomeOffice Assistant - Environment Configuration
#
# IMPORTANT: This app uses minimal environment variables.
# All integration settings (Paperless, Immich, Unsplash, LLM, SMTP) are configured
# via the web UI and stored encrypted in the database.

# REQUIRED: Secret key for encryption and session security (at least 32 characters,
# the application refuses to start with a shorter one)
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# OPTIONAL: Database URL (defaults to SQLite)
# SQLite (default): sqlite:///./data/homeoffice_assistant.db
# PostgreSQL: postgresql://user:password@localhost:5432/homeoffice_assistant
DATABASE_URL=sqlite:///./data/homeoffice_assistant.db

# OPTIONAL: Proxy addresses whose X-Forwarded-* headers are trusted (comma-separated,
# or "*"). Docker image only. Set it to your TLS-terminating reverse proxy so the
# session cookie is marked secure behind it. Default: 127.0.0.1
# FORWARDED_ALLOW_IPS=

# OPTIONAL: PostgreSQL password (only if using PostgreSQL via docker-compose)
# POSTGRES_PASSWORD=
